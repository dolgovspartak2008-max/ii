APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
TELEGRAM_BUSINESS_BOT_TOKEN=123456789:replace-with-real-business-token
TELEGRAM_ACCESS_BOT_TOKEN=123456789:replace-with-real-access-token
ADMIN_TELEGRAM_ID=123456789
TELEGRAM_ACCESS_WEBHOOK_SECRET=replace-with-a-random-32-character-secret
TELEGRAM_BUSINESS_WEBHOOK_SECRET=replace-with-a-different-random-32-character-secret
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=openrouter/auto
